# MLflow Local Deployment Configuration
# Copie este arquivo para .env e ajuste os valores conforme necessário

# ============================================
# Build Configuration
# ============================================
# O MLflow é construido a partir do Dockerfile.mlflow
# que estende a imagem oficial com suporte a PostgreSQL (psycopg2)
# Execute: docker-compose build --no-cache mlflow-server
# para reconstruir a imagem após alterações no Dockerfile

# ============================================
# MLflow Server Configuration
# ============================================
MLFLOW_PORT=5000
MLFLOW_WORKERS=2

# ============================================
# PostgreSQL Configuration (usado no docker-compose.yml completo)
# ============================================
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=mlflow_secure_password_2024
POSTGRES_DB=mlflow_db

# ============================================
# MinIO Configuration (S3-like storage local)
# ============================================
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_secret_key_2024

# ============================================
# MLflow Client Configuration (usado no código Python)
# ============================================
# URL do servidor MLflow
MLFLOW_TRACKING_URI=http://localhost:5000

# Credenciais para artifact store (MinIO)
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin_secret_key_2024

# Nome do experimento para Dummy Baseline
MLFLOW_DUMMY_EXPERIMENT_NAME=tech-challenge-dummy-baseline

# Nome específico do experimento para MLP
MLFLOW_MLP_EXPERIMENT_NAME=tech-challenge-mlp

# Nome do experimento para Logistic Regression
MLFLOW_LOGISTIC_EXPERIMENT_NAME=tech-challenge-logistic-regression

# ============================================
# Configurações para o DVC
# Repo e self-contained (cache commitado no Git). Opcional: defina um remote
# para compartilhar artefatos com a equipe (ex: caminho local do OneDrive).
# ============================================
DVC_ONEDRIVE_REMOTE_URL=

# ============================================
# Logging Configuration
# ============================================
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Log format: json (production) ou text (desenvolvimento local)
LOG_FORMAT=json

# Latencia SLO threshold em milissegundos
# Requisicoes excedendo este valor emitem WARNING
PREDICTION_SLO_MS=500.0

# ============================================
# API Configuration
# ============================================
# Porta da API FastAPI
API_PORT=8000

# ============================================
# Grafana Configuration
# ============================================
# Credenciais do Grafana (alterar em producao)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
