# ============================================================
# Tech Challenge Fase 1 - Variáveis de Ambiente
# ============================================================
# Como usar:
# 1. Copie este arquivo para .env: cp .env.example .env
# 2. Preencha os valores reais no arquivo .env
# 3. NUNCA commit o arquivo .env 
# ============================================================

# ============================================================
# API Configuration
# ============================================================
# Porta em que a API vai rodar (padrão: 8000)
PORT=8000

# Host para binding da API (0.0.0.0 para aceitar conexões externas)
HOST=0.0.0.0

# Ambiente de execução: development, staging, production
ENVIRONMENT=development

# Habilitar/desabilitar modo debug (true apenas em desenvolvimento)
DEBUG=true

# ============================================================
# Security
# ============================================================
# Token para autenticação de API (use um valor seguro em produção)
# Exemplo de geração: openssl rand -hex 32
API_TOKEN=seu_token_aqui

# Secret key para JWT (apenas se usar autenticação JWT)
JWT_SECRET=sua_secret_key_aqui

# Chave para criptografia de dados sensíveis
ENCRYPTION_KEY=sua_chave_de_criptografia

# ============================================================
# Database
# ============================================================
# URL de conexão com o banco de dados
# Formato: dialect+driver://username:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# URL alternativa para testes
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/test_dbname

# ============================================================
# ML Model Configuration
# ============================================================
# Caminho para o modelo treinado
MODEL_PATH=./models/model.pkl

# Versão do modelo em produção
MODEL_VERSION=1.0.0

# Caminho para dados de treino
TRAINING_DATA_PATH=./data/raw/training.csv

# Caminho para dados de teste
TEST_DATA_PATH=./data/raw/test.csv

# Diretório para salvar artefatos de experimentos
EXPERIMENT_TRACKING_DIR=./experiments

# ============================================================
# MLflow / Experiment Tracking
# ============================================================
# URI do tracking server MLflow
MLFLOW_TRACKING_URI=http://localhost:5000

# URI do artifact store (S3, GCS, Azure, local)
MLFLOW_ARTIFACT_URI=./mlruns

# Experimento padrão
MLFLOW_EXPERIMENT_NAME=tech-challenge-fase-1

# ============================================================
# Logging
# ============================================================
# Nível de log: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Formato do log: text ou json (json recomendado para produção)
LOG_FORMAT=json

# Caminho para arquivo de log (opcional)
LOG_FILE_PATH=./logs/app.log

# ============================================================
# Rate Limiting (Proteção contra abuso)
# ============================================================
# Limite de requisições por minuto por IP
RATE_LIMIT_PER_MINUTE=60

# Limite de requisições por hora
RATE_LIMIT_PER_HOUR=1000

# ============================================================
# Monitoring (Prometheus/Grafana)
# ============================================================
# Habilitar métricas Prometheus
METRICS_ENABLED=true

# Porta para métricas Prometheus (diferente da porta da API)
METRICS_PORT=9090

# Endpoint para métricas
METRICS_ENDPOINT=/metrics

# ============================================================
# CORS (Cross-Origin Resource Sharing)
# ============================================================
# Origens permitidas (separadas por vírgula)
# Use '*' para permitir todas (não recomendado em produção)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Métodos HTTP permitidos
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE

# Headers permitidos
CORS_ALLOWED_HEADERS=Content-Type,Authorization

# ============================================================
# Data Paths
# ============================================================
# Diretório raiz para dados
DATA_DIR=./data

# Diretório para dados brutos
RAW_DATA_DIR=./data/raw

# Diretório para dados processados
PROCESSED_DATA_DIR=./data/processed

# Diretório para dados externos (APIs, downloads)
EXTERNAL_DATA_DIR=./data/external

# ============================================================
# Cloud / Deployment (quando aplicável)
# ============================================================
# Região da cloud
AWS_REGION=us-east-1

# Nome do bucket S3 para artefatos
S3_BUCKET_NAME=seu-bucket-s3

# Azure Storage (se usar Azure)
AZURE_STORAGE_CONNECTION_STRING=sua_connection_string

# Google Cloud (se usar GCP)
GOOGLE_APPLICATION_CREDENTIALS=./credentials/gcp-key.json

# ============================================================
# Feature Store (se aplicável)
# ============================================================
# URI do feature store
FEATURE_STORE_URI=redis://localhost:6379

# TTL das features em segundos
FEATURE_TTL=3600

# ============================================================
# Cache
# ============================================================
# URI do cache (Redis recomendado)
CACHE_URI=redis://localhost:6379/0

# TTL do cache em segundos
CACHE_TTL=300

# ============================================================
# Email / Notificações (opcional)
# ============================================================
# Configurações SMTP para alertas
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASSWORD=sua_senha_app

# Email para notificações de erro
ALERT_EMAIL=admin@exemplo.com
