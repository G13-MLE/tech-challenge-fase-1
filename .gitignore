# ============================================================
# Data Science / ML
# ============================================================
# Dados (mantenha apenas exemplos pequenos no git)
/data/raw/*
/data/processed/*
/data/external/*
!/data/raw/.gitkeep
!/data/processed/.gitkeep
!/data/external/.gitkeep

# Modelos treinados (pode ser grande)
/models/*.pkl
/models/*.h5
/models/*.joblib
/models/*.pt
/models/*.pth
!/models/.gitkeep

# MLflow
mlruns/
mlartifacts/

# Weights & Biases
wandb/

# TensorBoard
runs/
logs/

