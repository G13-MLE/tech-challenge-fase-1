FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PYTHONPATH=/app

WORKDIR /app

# Copia os arquivos do projeto para gerenciar dependencias
COPY pyproject.toml uv.lock ./

# Instala apenas as dependencias (otimiza o cache do Docker)
RUN uv sync --frozen --no-install-project --no-group dev

# Copia todo o codigo fonte (incluindo api, data, training, etc.)
COPY src ./src

# Comando padrao para a API
CMD ["uv", "run", "fastapi", "run", "src/api/main.py", "--host", "0.0.0.0", "--port", "8000"]
